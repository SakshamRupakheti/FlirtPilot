AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Only needed when explicitly selecting AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
# Hosted free-tier option: set AI_PROVIDER=groq. Never reuse an OpenAI key here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set to off to disable the reviewed public example library (not local user memory).
AI_CURATED_EXAMPLES=on
APP_NAME=FlirtPilot
# Optional keyboard device credential (32+ random characters). Never an AI key.
# The keyboard endpoint stays disabled while this is empty.
KEYBOARD_ACCESS_TOKEN=
